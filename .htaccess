# Tschudnow Profi Service – Apache-Konfiguration für das netcup Webhosting

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # www -> ohne www (kanonische Adresse: tschudnow-handwerk.de)
  RewriteCond %{HTTP_HOST} ^www\.tschudnow-handwerk\.de$ [NC]
  RewriteRule ^ https://tschudnow-handwerk.de%{REQUEST_URI} [R=301,L]

  # HTTPS erzwingen – ERST aktivieren, wenn im netcup-Panel ein gültiges
  # Let's-Encrypt-Zertifikat für tschudnow-handwerk.de (und www) aktiv ist.
  # Stand der Einrichtung: noch kein gültiges Zertifikat, daher auskommentiert.
  # RewriteCond %{HTTPS} !=on
  # RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  # RewriteCond %{HTTP_HOST} ^tschudnow-handwerk\.de$ [NC]
  # RewriteRule ^ https://tschudnow-handwerk.de%{REQUEST_URI} [R=301,L]
</IfModule>

# Repository-/Hilfsdateien nicht ausliefern
<FilesMatch "^(README\.md|\.git.*|\.deploy-manifest)$">
  Require all denied
</FilesMatch>
